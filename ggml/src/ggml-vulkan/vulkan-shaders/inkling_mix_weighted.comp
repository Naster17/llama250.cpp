#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly  buffer A { float data_a[]; }; // states [n_embd, n_states, n_tokens]
layout (binding = 1) readonly  buffer B { float data_b[]; }; // scores [n_states, n_q, n_tokens]
layout (binding = 2) writeonly buffer D { float data_d[]; }; // dst    [n_embd, n_q, n_tokens]

layout (push_constant) uniform parameter {
    uint n_embd;
    uint n_states;
    uint n_q;
    uint n_tokens;
    uint a_offset;
    uint b_offset;
    uint d_offset;
} p;

void main() {
    const uint e = gl_GlobalInvocationID.x;
    const uint q = gl_WorkGroupID.y;
    const uint t = gl_WorkGroupID.z;

    if (e >= p.n_embd || q >= p.n_q || t >= p.n_tokens) {
        return;
    }

    const uint s_base = p.a_offset + t * p.n_states * p.n_embd + e;
    const uint w_base = p.b_offset + (t * p.n_q + q) * p.n_states;

    float acc = 0.0f;
    for (uint s = 0; s < p.n_states; ++s) {
        acc += data_a[s_base + s * p.n_embd] * data_b[w_base + s];
    }

    data_d[p.d_offset + (t * p.n_q + q) * p.n_embd + e] = acc;
}
