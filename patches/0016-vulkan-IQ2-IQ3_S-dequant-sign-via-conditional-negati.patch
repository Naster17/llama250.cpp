From 8ae722e55e5c9d882caa6adb8452eaaa93587043 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Thu, 19 Nov 2026 23:42:14 +0100
Subject: [PATCH 16/18] vulkan : IQ2/IQ3_S dequant sign via conditional
 negation

Extend the 0013 trick to IQ2_XXS/IQ2_XS/IQ2_S/IQ3_S: free RDNA2 source-modifier
negation instead of multiply by +/-1. test-backend-ops MUL_MAT,MUL_MAT_VEC
2604/2604 OK on Vulkan0 (BC-250). End-to-end pp check pending IQ3_XXS model download.

Assisted-by: Qwen3.8-Max
---
 .../vulkan-shaders/dequant_funcs.glsl         | 48 +++++++++----------
 1 file changed, 24 insertions(+), 24 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl
index 9b84bba63..c51577102 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/dequant_funcs.glsl
@@ -249,8 +249,8 @@ vec2 dequantize(uint ib, uint iqs, uint a_offset) {
     bool sign0 = (sign & 1) != 0;
     bool sign1 = (sign & 2) != 0;
     return db * vec2(
-        grid.x * (sign0 ? -1.0 : 1.0),
-        grid.y * (sign1 ? -1.0 : 1.0)
+        sign0 ? -float(grid.x) : float(grid.x),
+        sign1 ? -float(grid.y) : float(grid.y)
     );
 }
 vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
@@ -271,10 +271,10 @@ vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
     bool sign2 = (sign & 4) != 0;
     bool sign3 = (sign & 8) != 0;
     return db * vec4(
-        grid.x * (sign0 ? -1.0 : 1.0),
-        grid.y * (sign1 ? -1.0 : 1.0),
-        grid.z * (sign2 ? -1.0 : 1.0),
-        grid.w * (sign3 ? -1.0 : 1.0)
+        sign0 ? -float(grid.x) : float(grid.x),
+        sign1 ? -float(grid.y) : float(grid.y),
+        sign2 ? -float(grid.z) : float(grid.z),
+        sign3 ? -float(grid.w) : float(grid.w)
     );
 }
 #endif
@@ -292,8 +292,8 @@ vec2 dequantize(uint ib, uint iqs, uint a_offset) {
     bool sign0 = (sign & 1) != 0;
     bool sign1 = (sign & 2) != 0;
     return db * vec2(
-        grid.x * (sign0 ? -1.0 : 1.0),
-        grid.y * (sign1 ? -1.0 : 1.0)
+        sign0 ? -float(grid.x) : float(grid.x),
+        sign1 ? -float(grid.y) : float(grid.y)
     );
 }
 vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
@@ -310,10 +310,10 @@ vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
     bool sign2 = (sign & 4) != 0;
     bool sign3 = (sign & 8) != 0;
     return db * vec4(
-        grid.x * (sign0 ? -1.0 : 1.0),
-        grid.y * (sign1 ? -1.0 : 1.0),
-        grid.z * (sign2 ? -1.0 : 1.0),
-        grid.w * (sign3 ? -1.0 : 1.0)
+        sign0 ? -float(grid.x) : float(grid.x),
+        sign1 ? -float(grid.y) : float(grid.y),
+        sign2 ? -float(grid.z) : float(grid.z),
+        sign3 ? -float(grid.w) : float(grid.w)
     );
 }
 #endif
@@ -334,8 +334,8 @@ vec2 dequantize(uint ib, uint iqs, uint a_offset) {
     bool sign0 = (sign & 1) != 0;
     bool sign1 = (sign & 2) != 0;
     return db * vec2(
-        grid[iqs % 4] * (sign0 ? -1.0 : 1.0),
-        grid[(iqs % 4) + 1] * (sign1 ? -1.0 : 1.0)
+        sign0 ? -float(grid[iqs % 4]) : float(grid[iqs % 4]),
+        sign1 ? -float(grid[(iqs % 4) + 1]) : float(grid[(iqs % 4) + 1])
     );
 }
 vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
@@ -355,10 +355,10 @@ vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
     bool sign2 = (sign & 4) != 0;
     bool sign3 = (sign & 8) != 0;
     return db * vec4(
-        grid.x * (sign0 ? -1.0 : 1.0),
-        grid.y * (sign1 ? -1.0 : 1.0),
-        grid.z * (sign2 ? -1.0 : 1.0),
-        grid.w * (sign3 ? -1.0 : 1.0)
+        sign0 ? -float(grid.x) : float(grid.x),
+        sign1 ? -float(grid.y) : float(grid.y),
+        sign2 ? -float(grid.z) : float(grid.z),
+        sign3 ? -float(grid.w) : float(grid.w)
     );
 }
 #endif
@@ -422,8 +422,8 @@ vec2 dequantize(uint ib, uint iqs, uint a_offset) {
     const float db = 1 + 2 * ((scale >> (4 * ((iqs / 32) & 1))) & 0xf);
     const uint32_t grid = iq3s_grid[qs | ((qh << (8 - ((iqs / 4) % 8))) & 256)] >> (8 * (iqs % 4));
     return db * vec2(
-        int(grid & 0xFF) * (sign0 ? -1.0 : 1.0),
-        int((grid >> 8) & 0xFF) * (sign1 ? -1.0 : 1.0)
+        sign0 ? -float(grid & 0xFF) : float(grid & 0xFF),
+        sign1 ? -float((grid >> 8) & 0xFF) : float((grid >> 8) & 0xFF)
     );
 }
 vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
@@ -440,10 +440,10 @@ vec4 dequantize4(uint ib, uint iqs, uint a_offset) {
     const float db = 1 + 2 * ((scale >> (4 * (ib32 & 1))) & 0xf);
     const uint32_t grid = iq3s_grid[qs | ((qh << (8 - ib4 % 8)) & 256)] >> (8 * (iqs % 4));
     return db * vec4(
-        int(grid & 0xFF) * (sign0 ? -1.0 : 1.0),
-        int((grid >> 8) & 0xFF) * (sign1 ? -1.0 : 1.0),
-        int((grid >> 16) & 0xFF) * (sign2 ? -1.0 : 1.0),
-        int((grid >> 24) & 0xFF) * (sign3 ? -1.0 : 1.0)
+        sign0 ? -float(grid & 0xFF) : float(grid & 0xFF),
+        sign1 ? -float((grid >> 8) & 0xFF) : float((grid >> 8) & 0xFF),
+        sign2 ? -float((grid >> 16) & 0xFF) : float((grid >> 16) & 0xFF),
+        sign3 ? -float((grid >> 24) & 0xFF) : float((grid >> 24) & 0xFF)
     );
 }
 #endif
