From 1cc520248968f135fbcbd3885f412d387e5e4ce6 Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Sun, 22 Nov 2026 22:46:07 +0100
Subject: vulkan: guard unsynced sync against stale/non-Vulkan buffers

Tensor-split RPC warmup could leave stale or non-Vulkan tensor buffer
pointers in the Vulkan backend unsynced_nodes lists. ggml_vk_build_graph
overlap sync dereferenced buffer->buft unconditionally, segfaulting on
the RPC peer during llama-server warmup (split-mode tensor, RPC backend).

Guard overlaps_unsynced against null, garbage, and non-Vulkan buffers,
and clear unsynced node lists at graph_compute entry.

Assisted-by: openai/gpt-5.4
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index b9a2248b2..77888449f 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -13713,7 +13713,16 @@ bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph, in
         // checked against the written list. Two nodes overlap in memory if they come from the same
         // buffer and the tensor or view ranges overlap.
         auto const &overlaps_unsynced = [&](const ggml_tensor *node, const std::vector<const ggml_tensor *> &unsynced_nodes) -> bool {
-            if (unsynced_nodes.size() == 0) {
+            if (unsynced_nodes.size() == 0 || node->buffer == nullptr) {
+                return false;
+            }
+            if ((uintptr_t)node->buffer < 0x10000) {
+                return false;
+            }
+            if ((uintptr_t)node->buffer->buft < 0x10000) {
+                return false;
+            }
+            if (node->buffer->buft->iface.get_name != ggml_backend_vk_buffer_type_name) {
                 return false;
             }
             auto n_base = vk_tensor_offset(node) + node->view_offs;
@@ -13721,6 +13730,12 @@ bool ggml_vk_build_graph(ggml_backend_vk_context * ctx, ggml_cgraph * cgraph, in
             ggml_backend_vk_buffer_context * a_buf_ctx = (ggml_backend_vk_buffer_context *)node->buffer->context;
             vk_buffer a_buf = a_buf_ctx->dev_buffer;
             for (auto &other : unsynced_nodes) {
+                if (other->buffer == nullptr || (uintptr_t)other->buffer < 0x10000) {
+                    continue;
+                }
+                if ((uintptr_t)other->buffer->buft < 0x10000 || other->buffer->buft->iface.get_name != ggml_backend_vk_buffer_type_name) {
+                    continue;
+                }
                 ggml_backend_vk_buffer_context * o_buf_ctx = (ggml_backend_vk_buffer_context *)other->buffer->context;
                 vk_buffer o_buf = o_buf_ctx->dev_buffer;
                 if (a_buf == o_buf) {
@@ -15880,6 +15895,10 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
     ctx->do_add_rms_partials = false;
     ctx->do_add_rms_partials_offset_calculation = false;
 
+    // stale tensor pointers from a previous graph (freed/reused cgraph) must not be dereferenced
+    ctx->unsynced_nodes_written.clear();
+    ctx->unsynced_nodes_read.clear();
+
     int last_node = cgraph->n_nodes - 1;
 
     // If the last op in the cgraph isn't backend GPU, the command buffer doesn't get closed properly
