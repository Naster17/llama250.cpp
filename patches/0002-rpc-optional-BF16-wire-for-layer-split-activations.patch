From 93ed3ec1bd5910cc7252a71a5b073d8f854b3a0f Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Sun, 15 Nov 2026 13:02:11 +0100
Subject: [PATCH] rpc : optional BF16 wire for layer-split activations

- GGML_RPC_WIRE_BF16=1 sends F32 activations as BF16 at split boundaries
  (+16% prefill on a 2-board 1 GbE cluster, greedy output identical)
- GGML_RPC_QUICKACK=1 experiment kept gated, no measured gain

Assisted-by: omp
---
 ggml/src/ggml-rpc/ggml-rpc.cpp  | 62 +++++++++++++++++++++++++++++++--
 ggml/src/ggml-rpc/transport.cpp |  8 +++++
 2 files changed, 68 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-rpc/ggml-rpc.cpp b/ggml/src/ggml-rpc/ggml-rpc.cpp
index e4a84cb0c..f15a56c52 100644
--- a/ggml/src/ggml-rpc/ggml-rpc.cpp
+++ b/ggml/src/ggml-rpc/ggml-rpc.cpp
@@ -220,6 +220,7 @@ struct rpc_msg_get_tensor_req {
     rpc_tensor tensor;
     uint64_t offset;
     uint64_t size;
+    uint64_t flags;
 };
 
 struct rpc_msg_copy_tensor_req {
@@ -865,6 +866,19 @@ static bool rpc_use_hash_cache(const rpc_dispatcher & dispatcher, const ggml_ten
     return dispatcher.get_send_tensor_hash() && size > HASH_THRESHOLD && tensor->buffer->usage == GGML_BACKEND_BUFFER_USAGE_WEIGHTS;
 }
 
+// experimental: send F32 activations as BF16 to halve wire traffic at split boundaries
+// client opts in with GGML_RPC_WIRE_BF16=1, server handles the wire flags unconditionally
+static bool rpc_wire_bf16_enabled() {
+    static const bool enabled = getenv("GGML_RPC_WIRE_BF16") != nullptr;
+    return enabled;
+}
+
+static bool rpc_wire_bf16_eligible(const ggml_tensor * tensor, size_t offset, size_t size) {
+    return rpc_wire_bf16_enabled() && tensor->type == GGML_TYPE_F32 &&
+           tensor->buffer->usage != GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+           size >= 65536 && size % 4 == 0 && offset % 4 == 0;
+}
+
 static void ggml_backend_rpc_buffer_set_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
     ggml_backend_rpc_buffer_context * ctx = (ggml_backend_rpc_buffer_context *)buffer->context;
     rpc_tensor rpc_tensor = serialize_tensor(tensor);
@@ -887,6 +901,14 @@ static void ggml_backend_rpc_buffer_set_tensor(ggml_backend_buffer_t buffer, ggm
         // the server has no cache entry for this tensor - ask it to save one
         cache_flag = 1;
     }
+    if (rpc_wire_bf16_eligible(tensor, offset, size)) {
+        std::vector<ggml_bf16_t> wire(size / 4);
+        ggml_fp32_to_bf16_row((const float *) data, wire.data(), (int64_t) (size / 4));
+        size_t header_size;
+        auto header = serialize_set_tensor(rpc_tensor, cache_flag | 2, offset, nullptr, 0, header_size);
+        ctx->dispatcher->send(RPC_CMD_SET_TENSOR, header, header_size, wire.data(), wire.size() * sizeof(ggml_bf16_t), nullptr, 0);
+        return;
+    }
     size_t header_size;
     auto header = serialize_set_tensor(rpc_tensor, cache_flag, offset, nullptr, 0, header_size);
     ctx->dispatcher->send(RPC_CMD_SET_TENSOR, header, header_size, data, size, nullptr, 0);
@@ -944,6 +966,13 @@ static void ggml_backend_rpc_buffer_get_tensor(ggml_backend_buffer_t buffer, con
     request->tensor = serialize_tensor(tensor);
     request->offset = offset;
     request->size = size;
+    if (rpc_wire_bf16_eligible(tensor, offset, size)) {
+        request->flags = 1;
+        std::vector<ggml_bf16_t> wire(size / 4);
+        ctx->dispatcher->send(RPC_CMD_GET_TENSOR, request, sizeof(*request), nullptr, 0, wire.data(), wire.size() * sizeof(ggml_bf16_t));
+        ggml_bf16_to_fp32_row(wire.data(), (float *) data, (int64_t) (size / 4));
+        return;
+    }
     ctx->dispatcher->send(RPC_CMD_GET_TENSOR, request, sizeof(*request), nullptr, 0, data, size);
 }
 
@@ -1505,6 +1534,8 @@ private:
     std::vector<comm_state> comm_states;
     // SET_TENSOR data is received in chunks through this buffer
     std::vector<uint8_t> set_tensor_buf;
+    // expanded F32 data for BF16 wire transfers
+    std::vector<uint8_t> set_tensor_f32_buf;
 };
 
 void rpc_server::hello(rpc_msg_hello_rsp & response) {
@@ -1766,7 +1797,8 @@ bool rpc_server::set_tensor(socket_ptr sock, uint64_t input_size) {
     const rpc_tensor * in_tensor = (const rpc_tensor *)header;
     memcpy(&cache_flag, header + sizeof(rpc_tensor), sizeof(cache_flag));
     memcpy(&offset,     header + sizeof(rpc_tensor) + sizeof(cache_flag), sizeof(offset));
-    const size_t size = input_size - header_size;
+    const bool wire_bf16 = (cache_flag & 2) != 0;
+    const size_t size = (input_size - header_size) * (wire_bf16 ? 2 : 1);
 
     struct ggml_init_params params {
         /*.mem_size   =*/ ggml_tensor_overhead(),
@@ -1797,7 +1829,7 @@ bool rpc_server::set_tensor(socket_ptr sock, uint64_t input_size) {
         }
     }
 
-    if (cache_dir && cache_flag) {
+    if (cache_dir && (cache_flag & 1)) {
         // the whole data is needed to compute the hash
         std::vector<uint8_t> data(size);
         if (!sock->recv_data(data.data(), size)) {
@@ -1817,6 +1849,25 @@ bool rpc_server::set_tensor(socket_ptr sock, uint64_t input_size) {
 
     // a buffer of the tensor size would be allocated and page faulted for every tensor, which is slow
     const size_t chunk_size = 16*1024*1024;
+    if (wire_bf16) {
+        const size_t wire_size = size / 2;
+        if (set_tensor_buf.size() < std::min(wire_size, chunk_size / 2)) {
+            set_tensor_buf.resize(std::min(wire_size, chunk_size / 2));
+        }
+        if (set_tensor_f32_buf.size() < std::min(size, chunk_size)) {
+            set_tensor_f32_buf.resize(std::min(size, chunk_size));
+        }
+        for (size_t done = 0; done < wire_size; ) {
+            const size_t n = std::min(wire_size - done, chunk_size / 2);
+            if (!sock->recv_data(set_tensor_buf.data(), n)) {
+                return false;
+            }
+            ggml_bf16_to_fp32_row((const ggml_bf16_t *) set_tensor_buf.data(), (float *) set_tensor_f32_buf.data(), (int64_t) (n / 2));
+            ggml_backend_tensor_set(tensor, set_tensor_f32_buf.data(), offset + done * 2, n * 2);
+            done += n;
+        }
+        return true;
+    }
     if (set_tensor_buf.size() < std::min(size, chunk_size)) {
         set_tensor_buf.resize(std::min(size, chunk_size));
     }
@@ -2030,6 +2081,13 @@ bool rpc_server::get_tensor(const rpc_msg_get_tensor_req & request, std::vector<
         }
     }
 
+    if (request.flags & 1) {
+        std::vector<uint8_t> f32_buf(request.size);
+        ggml_backend_tensor_get(tensor, f32_buf.data(), request.offset, request.size);
+        response.resize(request.size / 2);
+        ggml_fp32_to_bf16_row((const float *) f32_buf.data(), (ggml_bf16_t *) response.data(), (int64_t) (request.size / 4));
+        return true;
+    }
     response.resize(request.size, 0);
     ggml_backend_tensor_get(tensor, response.data(), request.offset, request.size);
     return true;
diff --git a/ggml/src/ggml-rpc/transport.cpp b/ggml/src/ggml-rpc/transport.cpp
index c7d9f5321..b00d391f2 100644
--- a/ggml/src/ggml-rpc/transport.cpp
+++ b/ggml/src/ggml-rpc/transport.cpp
@@ -597,6 +597,14 @@ bool socket_t::impl::recv_data(void * data, size_t size) {
         }
         bytes_recv += (size_t)n;
     }
+#ifdef TCP_QUICKACK
+    // re-arm quickack after each receive; the kernel clears it during the exchange
+    static const bool quickack = getenv("GGML_RPC_QUICKACK") != nullptr;
+    if (quickack) {
+        int one = 1;
+        setsockopt(fd, IPPROTO_TCP, TCP_QUICKACK, &one, sizeof(one));
+    }
+#endif
     return true;
 }
 
