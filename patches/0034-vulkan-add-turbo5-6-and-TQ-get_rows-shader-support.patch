+layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};
+
+void main() {
+    // 32 Lloyd-Max centroids for N(0, 1/128), antisymmetric (c[31-i] == -c[i]).
+    const float centroids[32] = float[32](
+        -0.288236, -0.237892, -0.204892, -0.179348,
+        -0.158003, -0.139353, -0.122569, -0.107141,
+        -0.092730, -0.079097, -0.066064, -0.053491,
+        -0.041269, -0.029304, -0.017515, -0.005827,
+         0.005827,  0.017515,  0.029304,  0.041269,
+         0.053491,  0.066064,  0.079097,  0.092730,
+         0.107141,  0.122569,  0.139353,  0.158003,
+         0.179348,  0.204892,  0.237892,  0.288236
+    );
+
+    const uint ib = gl_WorkGroupID.x;
+    const uint j  = gl_LocalInvocationID.x;  // element index 0..127
+
+    if (ib >= p.nel / 128) return;
+
+    const float norm = float(data_a[ib].norm);
+
+    // Sign-magnitude: qs nibble = magnitude index (0..15), qh bit = sign (1 = negative).
+    const uint mag = (uint(data_a[ib].qs[j / 2]) >> ((j % 2) * 4)) & 0xF;
+    const uint neg = (uint(data_a[ib].qh[j / 8]) >> (j % 8)) & 0x1;
+    const uint idx = neg != 0 ? (15u - mag) : (16u + mag);
+
+    data_b[ib * 128 + j] = D_TYPE(centroids[idx] * norm);
+}
