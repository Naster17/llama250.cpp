+/* ---------- helper: matrix-vector multiply ---------- */
+
+static void matvec(const float * M, const float * x, float * y, int d) {
+    /* y = M @ x, M is row-major d×d */
+    for (int i = 0; i < d; i++) {
+        float sum = 0.0f;
+        for (int j = 0; j < d; j++) {
+            sum += M[i * d + j] * x[j];
+        }
+        y[i] = sum;
+    }
+}
