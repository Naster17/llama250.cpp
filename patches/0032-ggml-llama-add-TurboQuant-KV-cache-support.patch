+ggml_type residual_type_from_env() {
+    const std::string value = env_string("TURBOANCHORKV_RESIDUAL_TYPE", "turbo2");
+    if (value == "turbo3") {
+        return GGML_TYPE_TURBO3_0;
+    }
+    if (value == "turbo4") {
+        return GGML_TYPE_TURBO4_0;
