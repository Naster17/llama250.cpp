+    assert(n_per_row % QK_TURBO6 == 0);
+
+    size_t row_size = (n_per_row / QK_TURBO6) * sizeof(block_turbo6_0);
+    for (int64_t row = 0; row < nrows; row++) {
+        quantize_row_turbo6_0_ref(
+            src + row * n_per_row,
+            (block_turbo6_0 *)((char *)dst + row * row_size),
+            n_per_row
+        );
+    }
+    return nrows * row_size;
+}
