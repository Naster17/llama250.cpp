+#      define TURBO_IQ_API __declspec(dllexport)
+#    else
+#      define TURBO_IQ_API __declspec(dllimport)
+#    endif
+#  else
+#    define TURBO_IQ_API __attribute__((visibility("default")))
+#  endif
+#else
+#  define TURBO_IQ_API
+#endif
