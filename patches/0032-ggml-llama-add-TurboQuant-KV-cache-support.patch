+};
+
+// ---- Midpoints for nearest 6-bit centroid lookup ----
+
+static __constant__ float TURBO6_MID[63] = {
+    -0.308676f, -0.272141f, -0.247031f, -0.227316f,
+    -0.210819f, -0.196478f, -0.183690f, -0.172074f,
