From 66971969023ea5aad050dc3d0c12b8c3bc9e582f Mon Sep 17 00:00:00 2001
From: Naster17 <naster17.dev@gmail.com>
Date: Tue, 24 Nov 2026 22:56:23 +0100
Subject: [PATCH] vulkan : include ggml_type_ids in flash_attn_base

Fix shader compile after upstream merge where GGML type IDs are missing
in flash attention mmq functions.

Assisted-by: opencode
---
 ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl | 1 +
 1 file changed, 1 insertion(+)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl
index f1a7140c5..2226929b4 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_base.glsl
@@ -1,3 +1,4 @@
+#include "ggml_type_ids.glsl"
 
 layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
 
-- 
2.56.1

