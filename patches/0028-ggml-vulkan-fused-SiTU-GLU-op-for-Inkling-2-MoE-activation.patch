diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/situ.comp b/ggml/src/ggml-vulkan/vulkan-shaders/situ.comp
new file mode 100644
index 000000000..97c11dc83
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/situ.comp
@@ -0,0 +1,13 @@
+#version 450
+
+#include "glu_head.glsl"
+
+// SiTU (Inkling-2): beta*tanh(a/beta)*sigmoid(a) * lb*tanh(b/lb)
+// beta and lb reuse the swiglu_oai alpha/limit push-constant slots
+float op(float a, float b) {
+    float ga = p.alpha * tanh(a / p.alpha) / (1.0f + exp(-a));
+    float gu = p.limit * tanh(b / p.limit);
+    return ga * gu;
+}
+
+#include "glu_main.glsl"
